{
  "name": "team-environment",
  "productName": "Team Environment",
  "version": "0.4.1",
  "description": "Team Environment - firma jako biuro w izometrycznym pixel-arcie (front, dane przykładowe)",
  "author": "Dawid Wawer, Mateusz Sobczak, Kamil Styn",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node scripts/uruchom.cjs",
    "dev": "vite",
    "build": "vite build",
    "dist": "vite build && electron-builder --win portable",
    "serwer": "vite build && vite preview"
  },
  "build": {
    "appId": "pl.ug.teamenvironment",
    "productName": "Team Environment",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "zasoby/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "zasoby/ikona.png"
    },
    "portable": {
      "artifactName": "TeamEnvironment-${version}.exe"
    }
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.10"
  }
}